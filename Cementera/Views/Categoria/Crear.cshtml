@model Modelos.Categoria;
@{
    ViewData["Title"] = "Crear Categoría";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post" asp-action="Crear">
    <div class="border p-3">
        <div class="form-group row">
            <h2 class="text-info pl-3">Nueva Categoría</h2>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="NombreCategoria" class="form-label">Nombre Categoría</label>
                        <input asp-for="NombreCategoria" type="text" class="form-control" required />
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-group">
                        <label asp-for="Orden" class="form-label">Orden</label>
                        <input asp-for="Orden" type="number" class="form-control" required />
                    </div>
                </div>
            </div>
            <br />
            <div class="d-grid gap-2 d-md-block">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-controller="Categoria" asp-action="Index" class="btn btn-primary">Cancelar</a>
            </div>
        </div>
    </div>
</form>
