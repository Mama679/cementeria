@model Modelos.TipoAplicacion
@{
    ViewData["Title"] = "Crear Tipo Aplicación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<form method="post" asp-action="Crear">
    <div class="border p-3">
        <div class="form-group row">
            <h2 class="text-info pl-3">Nuevo Tipo de Aplicación</h2>
        </div>
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label asp-for="Nombre" class="form-label">Nombre Tipo Aplicación</label>
                        <input asp-for="Nombre" type="text" class="form-control" required />
                    </div>
                </div>
            </div>
            <br>
            <div class="d-grid gap-2 d-md-block">
                <button type="submit" class="btn btn-primary">Guardar</button>
                <a asp-controller="TipoAplicacion" asp-action="Index" class="btn btn-primary">Cancelar</a>
            </div>
        </div>
    </div>

</form>
